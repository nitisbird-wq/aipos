meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{operatorEmail}}",
    "password": "{{operatorPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("login ok");
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
