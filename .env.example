# App
# Leave DATABASE_URL empty for DEV file store. Use a local/non-production URL for Postgres mode.
DATABASE_URL=
# Example (local only — placeholders, not production):
# DATABASE_URL=postgresql://aipos:aipos_dev_only@localhost:5432/aipos
FORCE_POSTGRES=false
# Set true only after applying apps/web/drizzle/0000_init.sql against DATABASE_URL.
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=replace-me-in-dev-only

# Optional: dedicated URL for repository contract / Postgres adapter tests
# AIPOS_TEST_DATABASE_URL=postgresql://aipos:aipos_dev_only@localhost:5432/aipos_test
# AIPOS_RUN_PG_TESTS=true

# Notion (minimum access Mission Registry DB)
# Real writes are disabled in v0.1; mock adapter is default.
NOTION_ADAPTER=mock
NOTION_MOCK_SUCCESS=true
NOTION_TOKEN=
NOTION_MISSIONS_DATABASE_ID=

# Linear workstream dispatch (Control Plane). Default mock — no external creates.
# Live mode requires Owner-provided API key + team id; fail closed if misconfigured.
LINEAR_ADAPTER=mock
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# Analysis — none = deterministic heuristic stub (no external AI)
ANALYZE_PROVIDER=none
# OPENAI_API_KEY=  # only if ANALYZE_PROVIDER=openai later

# App
APP_ENV=development
