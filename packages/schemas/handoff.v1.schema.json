{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.dev/schemas/handoff.v1.schema.json",
  "title": "AIPOS Handoff v1",
  "type": "object",
  "required": [
    "handoff_version",
    "mission_id",
    "mission_state",
    "received_context",
    "completed_work",
    "changes_made",
    "verification",
    "remaining_work",
    "failures",
    "decisions",
    "assumptions",
    "evidence_refs",
    "artifacts",
    "next_action",
    "human_action_required",
    "risk_notes",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "handoff_version": { "const": "handoff.v1" },
    "mission_id": { "type": "string" },
    "mission_state": {
      "type": "string",
      "enum": [
        "CAPTURED",
        "UNDERSTOOD",
        "STRATEGIZED",
        "PLANNED",
        "APPROVED",
        "DISPATCHED",
        "EXECUTING",
        "VERIFYING",
        "INTEGRATING",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "RECONCILING",
        "WAITING_HUMAN",
        "CANCELLED"
      ]
    },
    "received_context": { "type": "array", "items": { "type": "string" } },
    "completed_work": { "type": "array", "items": { "type": "string" } },
    "changes_made": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "remaining_work": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "human_action_required": { "type": ["string", "null"] },
    "risk_notes": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string" }
  },
  "additionalProperties": false
}
