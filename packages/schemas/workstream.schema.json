{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.local/schemas/workstream.schema.json",
  "title": "AIPOSWorkstream",
  "description": "ADR-006 executable workstream unit. Linear is operational work truth for instances; Notion remains mission/business/knowledge truth. status=ready means ready_to_dispatch_workstream (not Mission.status=ready).",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workstream_id",
    "mission_id",
    "title",
    "objective",
    "required_capabilities",
    "dependencies",
    "primary_operator",
    "supporting_operator",
    "tools_required",
    "inputs",
    "expected_output",
    "acceptance_criteria",
    "risk_level",
    "approval_required",
    "execution_order",
    "status",
    "correlation_id",
    "idempotency_key",
    "canonical_token"
  ],
  "properties": {
    "workstream_id": {
      "type": "string",
      "pattern": "^WS-MIS-[0-9]+-[0-9]{2,}$",
      "description": "Canonical workstream id, e.g. WS-MIS-3-01"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS-[0-9]+$",
      "description": "Parent mission id from Notion Mission Registry unique_id"
    },
    "parent_linear_issue": {
      "type": ["string", "null"],
      "description": "Parent Linear identifier from Phase 2 mission dispatch (e.g. NIT-9)"
    },
    "linear_issue_id": {
      "type": ["string", "null"],
      "description": "Child Linear issue identifier after dispatch"
    },
    "notion_mission_page_id": {
      "type": ["string", "null"]
    },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^WS-MIS-[0-9]+-[0-9]{2,}$" }
    },
    "primary_operator": {
      "type": "string",
      "enum": ["claude", "cursor", "n8n", "notion", "linear", "human", "unassigned"]
    },
    "supporting_operator": {
      "type": ["string", "null"],
      "enum": ["claude", "cursor", "n8n", "notion", "linear", "human", null]
    },
    "tools_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "document",
            "code_pr",
            "linear_update",
            "notion_page",
            "workflow",
            "decision_brief",
            "dataset",
            "other"
          ]
        },
        "location_hint": {
          "type": "string",
          "enum": ["notion", "linear_comment", "github_pr", "n8n_workflow", "chat", "other"]
        },
        "description": { "type": "string" }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "approval_required": {
      "type": "boolean",
      "description": "True when D-006.4 requires explicit Human Approval before dispatch/execute. False for autonomous L0–L1 (and eligible L2)."
    },
    "approval_reason": {
      "type": ["string", "null"]
    },
    "execution_order": {
      "type": "integer",
      "minimum": 1
    },
    "parallel_group": {
      "type": ["string", "null"],
      "description": "Workstreams sharing a group may run concurrently once dependencies are satisfied"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "awaiting_approval",
        "ready",
        "dispatched",
        "running",
        "succeeded",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Stable create key, e.g. ws:MIS-3:01:v1"
    },
    "canonical_token": {
      "type": "string",
      "pattern": "^AIPOS_WORKSTREAM_ID=WS-MIS-[0-9]+-[0-9]{2,}$"
    },
    "sensitivity_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  }
}
