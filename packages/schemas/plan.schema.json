{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.local/schemas/plan.schema.json",
  "title": "Plan",
  "description": "Phase 3a Planning aggregate (ADR-005). Schema-only contract; runtime persistence lands in later 3a implementation PRs (docs/PHASE_3_DELIVERY_PLAN.md).",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "mission_id",
    "plan_version",
    "status",
    "body",
    "created_by",
    "approved_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^PLN-" },
    "mission_id": { "type": "string", "pattern": "^MIS-" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "awaiting_approval", "approved", "rejected", "superseded", "cancelled"]
    },
    "body": { "type": "object" },
    "created_by": { "type": "string", "minLength": 1 },
    "approved_by": { "type": ["string", "null"] },
    "rejected_reason": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
