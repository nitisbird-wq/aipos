{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.local/schemas/command-gateway.schema.json",
  "title": "AIPOSGatewayCommand",
  "description": "ADR-007 draft. Design-only command object for AIPOS Command Gateway. Not wired to runtime yet. Every command requires correlation_id and approval.state. Secrets must never appear in payloads or responses.",
  "version": "0.1-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "correlation_id",
    "idempotency_key",
    "received_at",
    "channel",
    "actor",
    "intent",
    "approval",
    "route",
    "owner_status"
  ],
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "received_at": { "type": "string", "format": "date-time" },
    "channel": {
      "type": "string",
      "enum": [
        "n8n_webhook",
        "web",
        "chatgpt_actions",
        "mcp",
        "chat_trigger",
        "other"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["owner", "operator", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "raw_text": { "type": "string" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_class", "confidence", "entities"],
      "properties": {
        "route_class": {
          "type": "string",
          "enum": [
            "mission_intake",
            "status_query",
            "approval_response",
            "operator_dispatch",
            "result_collection",
            "system_audit",
            "emergency_stop",
            "unknown"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mission_id": {
              "type": ["string", "null"],
              "pattern": "^MIS-[0-9]+$"
            },
            "linear_issue": { "type": ["string", "null"] },
            "workstream_id": {
              "type": ["string", "null"],
              "pattern": "^WS-MIS-[0-9]+-[0-9]{2,}$"
            },
            "approval_decision": {
              "type": ["string", "null"],
              "enum": ["approve", "reject", null]
            },
            "target_operator": {
              "type": ["string", "null"],
              "enum": [
                "claude",
                "cursor",
                "n8n",
                "notion",
                "linear",
                "human",
                "openai",
                "chatgpt",
                null
              ]
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "required", "policy_version"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "decided_by": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"], "format": "date-time" },
        "policy_version": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subsystem"],
      "properties": {
        "subsystem": {
          "type": "string",
          "enum": [
            "frozen_intake",
            "linear_ops",
            "notion_read",
            "notion_write_verified",
            "operator_adapter",
            "audit_store",
            "kill_switch",
            "none"
          ]
        },
        "handoff_ref": { "type": ["string", "null"] }
      }
    },
    "owner_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_action"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "next_action": {
          "type": "string",
          "enum": [
            "none",
            "confirm_mission",
            "approve_dispatch",
            "wait",
            "clarify"
          ]
        }
      }
    },
    "notes": { "type": "string" }
  }
}
