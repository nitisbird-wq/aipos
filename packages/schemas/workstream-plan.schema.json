{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.local/schemas/workstream-plan.schema.json",
  "title": "AIPOSWorkstreamPlan",
  "description": "ADR-006 Mission Decomposer output: versioned workstream package for a dispatched Mission. Not a duplicate Mission approval — Phase 1 CONFIRM remains Mission gate.",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "mission_id",
    "parent_linear_issue",
    "plan_version",
    "mission_risk_level",
    "workstreams",
    "correlation_id",
    "created_at",
    "decomposer_version"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "pattern": "^MIS-[0-9]+$" },
    "parent_linear_issue": { "type": "string", "minLength": 1 },
    "notion_mission_page_id": { "type": ["string", "null"] },
    "plan_version": { "type": "integer", "minimum": 1 },
    "mission_risk_level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aipos.local/schemas/workstream.schema.json" }
    },
    "parallel_groups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "decomposer_version": { "type": "string", "const": "ADR-006.v1" }
  }
}
