{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipos.local/schemas/workstream-plan.schema.json",
  "title": "AIPOSWorkstreamPlan",
  "description": "ADR-006.v2 Mission Decomposer output. Work-first decomposition: objective → outcome → criteria → domain → reasoning/actions → dependencies → final deliverable → THEN capabilities. Operators deferred (Router HELD). Phase 1 CONFIRM remains Mission gate.",
  "version": "2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "mission_id",
    "parent_linear_issue",
    "plan_version",
    "mission_objective",
    "desired_outcome",
    "success_criteria",
    "domain",
    "final_deliverable",
    "explicit_assumptions",
    "owner_questions",
    "reasoning_actions",
    "integration_required",
    "mission_risk_level",
    "workstreams",
    "correlation_id",
    "created_at",
    "decomposer_version"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "pattern": "^MIS-[0-9]+$" },
    "parent_linear_issue": { "type": "string", "minLength": 1 },
    "notion_mission_page_id": { "type": ["string", "null"] },
    "plan_version": { "type": "integer", "minimum": 1 },
    "mission_objective": { "type": "string", "minLength": 1 },
    "desired_outcome": { "type": "string", "minLength": 1 },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "domain": {
      "type": "string",
      "enum": [
        "business_research",
        "business_planning",
        "software",
        "software_debug",
        "automation",
        "documentation",
        "executive_reporting",
        "project_planning",
        "data_analysis",
        "ops_monitoring",
        "incident",
        "knowledge",
        "product_ideation",
        "prototype",
        "integration",
        "recurring_ops",
        "decision",
        "mixed_research_software",
        "mixed_research_automation",
        "architecture",
        "unknown",
        "blocked_unsafe"
      ]
    },
    "domain_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "final_deliverable": { "type": "string", "minLength": 1 },
    "explicit_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "source": { "type": "string", "enum": ["inferred", "user_stated", "knowledge"] }
        }
      }
    },
    "owner_questions": {
      "type": "array",
      "description": "Genuine blockers only. Prefer empty when assumptions suffice.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "reasoning_actions": {
      "type": "array",
      "minItems": 1,
      "description": "Domain actions before packaging into workstreams. Not operators.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "produces"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "produces": { "type": "string" },
          "consumes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "integration_required": { "type": "boolean" },
    "mission_risk_level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aipos.local/schemas/workstream.schema.json" }
    },
    "parallel_groups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "decomposer_version": { "type": "string", "const": "ADR-006.v2" }
  }
}
